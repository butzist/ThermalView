export FLAKE_ROOT=$(pwd)

# Extra arguments handed to the outer bwrap jail (rtk-shell / harness) so the
# USB thermal adapter is visible inside the sandbox.  Only the specific serial
# device nodes are shared -- never the whole of /dev.
#
#   /dev/ttyUSB*, /dev/ttyACM*  the adapter's tty nodes (read/write)
#   /dev/serial                 by-id / by-path symlinks (read-only, optional)
#   /sys                        USB + tty enumeration for pyserial/list_ports
#   /run/udev                   udev database (read-only)
#
# `--dev-bind-try` skips paths that do not exist, so the jail still starts when
# the adapter is unplugged.  Bind mounts are fixed at jail start: plug the
# adapter in first, then restart the jail / MCP client.
#
# If `/sys` should not be shared either, drop that argument and the driver will
# still work with an explicit --port /dev/ttyUSB0; only auto-detection is lost.
_thermal_serial_nodes=()
for _node in /dev/ttyUSB* /dev/ttyACM*; do
  [ -e "$_node" ] && _thermal_serial_nodes+=("$_node")
done
# Fallback when this file is evaluated inside a jail that cannot see the host
# /dev yet: name the usual nodes; missing ones are skipped by --dev-bind-try.
if [ ${#_thermal_serial_nodes[@]} -eq 0 ]; then
  _thermal_serial_nodes=(
    /dev/ttyUSB0 /dev/ttyUSB1 /dev/ttyUSB2 /dev/ttyUSB3
    /dev/ttyACM0 /dev/ttyACM1
  )
fi

JAIL_EXTRA_ARGS_THERMALVIEW="--ro-bind-try /sys /sys --ro-bind-try /run/udev /run/udev"
for _node in "${_thermal_serial_nodes[@]}"; do
  JAIL_EXTRA_ARGS_THERMALVIEW+=" --dev-bind-try $_node $_node"
done
# Read-only by-id/by-path symlinks; --ro-bind-try skips the path if absent.
JAIL_EXTRA_ARGS_THERMALVIEW+=" --ro-bind-try /dev/serial /dev/serial"

# Optional: pyusb / raw USB descriptor access.  This exposes the USB bus, so
# enable it deliberately (the default pyserial transport does not need it):
#   JAIL_EXTRA_ARGS_THERMALVIEW+=" --dev-bind-try /dev/bus/usb /dev/bus/usb"

unset _node _thermal_serial_nodes
export JAIL_EXTRA_ARGS="${JAIL_EXTRA_ARGS:-} ${JAIL_EXTRA_ARGS_THERMALVIEW}"

use flake
