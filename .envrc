export FLAKE_ROOT=$(pwd)

# Extra arguments handed to the outer bwrap jail (rtk-shell / harness) so the
# USB thermal adapter is visible inside the sandbox:
#
#   /dev        /dev/ttyUSB*, /dev/ttyACM*, /dev/serial/by-id, /dev/bus/usb
#               (pyserial + optional pyusb transport)
#   /sys        USB device/tty enumeration for lsusb, pyserial list_ports, udev
#   /run/udev   udev database / by-id metadata
#
# Note: this only takes effect when the jail wrapper is (re)started. If the
# devices stay invisible, restart the MCP client / shell session.
JAIL_EXTRA_ARGS_THERMALVIEW="--dev-bind-try /dev /dev --ro-bind-try /sys /sys --ro-bind-try /run/udev /run/udev"
export JAIL_EXTRA_ARGS="${JAIL_EXTRA_ARGS:-} ${JAIL_EXTRA_ARGS_THERMALVIEW}"

use flake
